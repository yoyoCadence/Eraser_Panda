{
  "name": "eraser-panda",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only single-HTML tool that strips classification labels, logos and sensitivity metadata from PDF / Office documents.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "e2e": "node e2e/smoke.cjs",
    "fixtures": "python3 scripts/make_fixtures.py && python3 scripts/make_pdf_fixtures.py"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
